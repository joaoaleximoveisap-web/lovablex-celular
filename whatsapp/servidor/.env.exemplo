# Copie para .env e preencha.

# Endereço do servidor. Sem domínio próprio, use o IP com traços + .sslip.io
# Ex.: IP 203.0.113.25  →  203-0-113-25.sslip.io
ENDERECO=203-0-113-25.sslip.io

# A chave mestra do Evolution (invente uma longa). É o secret EVOLUTION_API_KEY no GitHub.
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Senha do banco de dados interno (invente outra)
SENHA_BANCO=troque-esta-senha-tambem
